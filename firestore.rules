rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isMedicalStaff() {
      return isAuthenticated() && (request.auth.token.role in ['doctor', 'nurse', 'kinesiologist', 'admin']);
    }
    
    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow create, update: if isMedicalStaff() && request.resource.data.fullName is string;
      allow delete: if isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    match /visits/{visitId} {
      allow read: if isAuthenticated();
      allow create: if isMedicalStaff() && request.resource.data.patientId is string && request.resource.data.proofHash is string;
      allow update, delete: if false; // Actas clínicas inmutables
    }
    
    match /biomedical_equipment/{equipId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    match /emergency_swaps/{swapId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.equipmentId is string;
      allow update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
